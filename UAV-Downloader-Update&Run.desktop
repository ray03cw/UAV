cat << 'EOF' > ~/デスクトップ/UAV-Downloader-Update&Run.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=UAV-Downloader-Update&Run
Comment=Check update and run UAV Browser
Exec=/home/hibiki/Software/UAV-Downloader/run_uav.sh
Icon=utilities-terminal
Terminal=true
Categories=Utility;
EOF

chmod +x ~/デスクトップ/UAV-Downloader-Update&Run.desktop
gio set ~/デスクトップ/UAV-Downloader-Update&Run.desktop metadata::trusted true 2>/dev/null || true
